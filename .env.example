# Copia este archivo a .env y rellena los valores desde el dashboard de Supabase
# (Project Settings > API y Project Settings > Database).

# --- Base de datos (Prisma) ---
# Connection pooling (puerto 6543, pgbouncer) - usada en runtime por la app
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (puerto 5432, sin pooler) - usada solo por Prisma para migraciones
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Supabase API (Auth, Storage) ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
# Secreta: solo se usa en el servidor, nunca exponer al cliente
SUPABASE_SERVICE_ROLE_KEY="..."

# --- Mistral (análisis de guion con IA) ---
# Gratis: crear la key en https://console.mistral.ai (API Keys)
MISTRAL_API_KEY="..."

# --- SEO / dominio público ---
# URL real donde vive la web pública (sin barra final). En local déjalo como está.
# En producción (Vercel), pon aquí el dominio definitivo, ej: https://versiondefinitiva.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Lemon Squeezy (plan PRO) ---
# Opcional: sin estas variables, la sección de precios se oculta sola y
# nadie puede pagar (tampoco pasa nada, simplemente no se ha activado).
# Enlaces de checkout de cada variante (Store > Products > variante > "Copy checkout URL")
LEMONSQUEEZY_CHECKOUT_URL_MONTHLY="https://tu-tienda.lemonsqueezy.com/checkout/buy/..."
LEMONSQUEEZY_CHECKOUT_URL_YEARLY="https://tu-tienda.lemonsqueezy.com/checkout/buy/..."
# Opcional: pago único "PRO de por vida" (producto tipo "Single Payment"). Sin
# esta variable, la tarjeta de pago único no se muestra — solo mensual/anual.
LEMONSQUEEZY_CHECKOUT_URL_LIFETIME="https://tu-tienda.lemonsqueezy.com/checkout/buy/..."
# Secreto del webhook (Settings > Webhooks al crearlo) — activa/desactiva PRO automáticamente
LEMONSQUEEZY_WEBHOOK_SECRET="..."

# --- Sentry (monitorización de errores en producción) ---
# Opcional: sin estas variables, el SDK no envía nada a ningún sitio (no
# rompe nada, simplemente no hay captura de errores todavía).
# Crear cuenta gratis en https://sentry.io, un proyecto Next.js y copiar su DSN.
NEXT_PUBLIC_SENTRY_DSN="https://...@o0.ingest.sentry.io/0"
SENTRY_DSN="https://...@o0.ingest.sentry.io/0"
# Solo necesarios para que el build suba sourcemaps (Settings > Auth Tokens)
SENTRY_ORG="..."
SENTRY_PROJECT="..."
SENTRY_AUTH_TOKEN="..."

# --- Resend (recordatorios de call sheet por email — función PRO) ---
# Crear cuenta gratis en https://resend.com, verificar un dominio o
# subdominio propio (necesario para mandar a direcciones que no sean la
# tuya) y crear una API Key.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Taller <notificaciones@tudominio.com>"

# --- Cron (recordatorios automáticos) ---
# Secreto que Vercel manda solo en las llamadas programadas (vercel.json)
# para que nadie más pueda disparar el envío visitando la URL a mano.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET="..."
