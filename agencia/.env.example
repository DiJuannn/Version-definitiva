# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.

# PostgreSQL (local: createdb corte_dev). En producción, la cadena del proveedor.
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/corte_dev"

# URL pública de la app (sin barra final). Se usa en los enlaces de los emails.
APP_URL="http://localhost:3100"

# Secreto para firmar URLs de media (mínimo 32 caracteres). Genera uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=""

# Almacenamiento de media. Por ahora solo "local" (carpeta del servidor).
# En Vercel NO sirve: hace falta un proveedor de objetos (S3/R2), pendiente.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage"

# Email (opcional). Sin estas dos variables los emails quedan como "omitidos"
# en Ajustes > Correo saliente; los avisos dentro de la app funcionan igual.
RESEND_API_KEY=""
EMAIL_FROM=""

# Secreto para /api/cron/outbox (cabecera Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=""

# IA (opcional). "none" desactiva todas las funciones de IA.
AI_PROVIDER="none"
ANTHROPIC_API_KEY=""
AI_MODEL=""
